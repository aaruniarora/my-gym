{
  "$ref": "#/definitions/SkillTrees",
  "definitions": {
    "SkillTrees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "strength",
              "straight_arm",
              "balance",
              "flexibility",
              "core"
            ]
          },
          "straightArm": {
            "type": "boolean"
          },
          "perSide": {
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exerciseId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "sets": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reps": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "seconds": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cmFromFloor": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "sets"
                  ],
                  "additionalProperties": false
                },
                "checkSet": {
                  "type": "object",
                  "properties": {
                    "sets": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reps": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "seconds": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cmFromFloor": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "sets"
                  ],
                  "additionalProperties": false
                },
                "gate": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requirements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "testId": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                          },
                          "metric": {
                            "type": "string",
                            "enum": [
                              "reps",
                              "seconds",
                              "cm_from_floor",
                              "pass_fail",
                              "cm_height"
                            ]
                          },
                          "min": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "testId",
                          "metric",
                          "min"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "description",
                    "requirements"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "exerciseId",
                "target"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "maintenance": {
            "type": "object",
            "properties": {
              "setsPerWeek": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "setsPerWeek"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "straightArm",
          "steps",
          "maintenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
