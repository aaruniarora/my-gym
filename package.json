{
  "name": "my-gym",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "schema:gen": "tsx scripts/gen-schema.ts",
    "icons": "node scripts/make-icons.mjs",
    "media:used": "node scripts/build-exdb-used.mjs",
    "media:fetch": "node scripts/fetch-exdb-media.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
